<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
  </PropertyGroup>
  <ItemGroup>
    <None Include="license.rtf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.5" />
  </ItemGroup>
  <PropertyGroup>
    <PostBuildEvent>if exist "$(SolutionDir)MSCV-GlobalSign.cer" (
    "$(WindowsSDK_ExecutablePath_x86)\signtool.exe" sign /ac "$(SolutionDir)MSCV-GlobalSign.cer" /d "j2534-logger Installer" /du "http://www.drewtech.com/" /n "Drew Technologies, Inc." "$(TargetPath)"
) else (
    echo Warning: MSCV-GlobalSign.cer not found. Skipping code signing.
)
</PostBuildEvent>
  </PropertyGroup>
</Project>